        ),
        ("fbcode//comms/mccl/utils/McclLogger.h",),
    ),
    (
        "MCCL_ACTIVE_LOGGER_NAME_IMPL",
        regex(
            ".*(^|[^A-Za-z0-9_])MCCL_ACTIVE_LOGGER_NAME_IMPL([^A-Za-z0-9_]|$).*",
        ),
        ("fbcode//comms/mccl/utils/McclLogger.h",),
    ),
    (
        "CTRAN_LOG_SYNC_ERR",
        regex(".*(^|[^A-Za-z0-9_])CTRAN_LOG_SYNC_ERR([^A-Za-z0-9_]|$).*"),
        (
            "fbcode//comms/ctran/utils/CtranLogger.h",
