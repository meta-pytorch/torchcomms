# Version nodes for the delegation test's stub libibverbs.
#
# The nodes have to match what the shim asks dlvsym for, verb by verb, because a
# wrong node fails exactly like a missing symbol -- which is the whole failure
# mode this test exists to catch on the real provider.
#
# mlx5dv_query_device is listed on a node too, but the shim resolves it with
# plain dlsym. A name with a single definition becomes the default version, and
# that is what dlsym finds, so one node serves both lookup styles. Exercising
# that here is deliberate: it is the same property the real vendored libmlx5
# relies on.

IBVERBS_1.1 {
    global:
        ibv_query_device;
        # The object lifecycle the deregister-on-success test drives. Same node
        # as ibv_query_device because that is what the shim's realSym asks for.
        ibv_open_device;
        ibv_close_device;
        ibv_create_cq;
        ibv_destroy_cq;
    local:
        *;
};

# Not libibverbs symbols: the knobs that make the stub's destroy verbs fail. On
# their own node so they cannot be mistaken for part of the provider surface, and
# with a single definition each so plain dlsym finds them.
IB_INJECTION_STUB_1.0 {
    global:
        stubSetDestroyCqRet;
        stubSetCloseDeviceRet;
    local:
        *;
};

MLX5_1.2 {
    global:
        mlx5dv_init_obj;
    local:
        *;
};

MLX5_1.8 {
    global:
        mlx5dv_query_device;
    local:
        *;
};
