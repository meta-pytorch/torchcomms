# Every verb buildIbvSymbols resolves, at the exact version it asks for.
#
# The shim opens the real provider RTLD_LOCAL, so anything missing here is simply
# absent from this handle and LOAD_IBVERBS_SYM fails ibvInit(). A wrong version
# node fails identically to a missing symbol, which is why the nodes below mirror
# IbverbxSymbols.def rather than being grouped for tidiness.
#
# Nothing else is exported. The next diff adds a control surface on its own node,
# plus hot-path shims that are deliberately never exported at all -- those are
# reached by address, through the ibv_context ops vtable.

IBVERBS_1.0 {
    global:
        ibv_create_comp_channel;
        ibv_destroy_comp_channel;
        ibv_get_cq_event;
        ibv_ack_cq_events;
    local:
        *;
};

IBVERBS_1.1 {
    global:
        ibv_get_device_list;
        ibv_free_device_list;
        ibv_get_device_name;
        ibv_open_device;
        ibv_close_device;
        ibv_get_async_event;
        ibv_ack_async_event;
        ibv_query_device;
        ibv_query_port;
        ibv_query_gid;
        ibv_query_qp;
        ibv_alloc_pd;
        ibv_alloc_parent_domain;
        ibv_dealloc_pd;
        ibv_reg_mr;
        ibv_dereg_mr;
        ibv_create_cq;
        ibv_destroy_cq;
        ibv_create_qp;
        ibv_modify_qp;
        ibv_destroy_qp;
        ibv_fork_init;
        ibv_event_type_str;
    local:
        *;
} IBVERBS_1.0;

IBVERBS_1.8 {
    global:
        ibv_reg_mr_iova2;
    local:
        *;
} IBVERBS_1.1;

IBVERBS_1.10 {
    global:
        ibv_query_ece;
        ibv_set_ece;
    local:
        *;
} IBVERBS_1.8;

IBVERBS_1.12 {
    global:
        ibv_reg_dmabuf_mr;
    local:
        *;
} IBVERBS_1.10;

IBVERBS_1.13 {
    global:
        ibv_is_fork_initialized;
    local:
        *;
} IBVERBS_1.12;

# mlx5 direct verbs. Served by this same library because ibverbx points both its
# dlopen calls at one file; see IbverbxSymbols.def.

MLX5_1.2 {
    global:
        mlx5dv_init_obj;
    local:
        *;
};

MLX5_1.8 {
    global:
        mlx5dv_is_supported;
        # Unversioned in ibverbx (plain dlsym, because fbcode's vendored libmlx5
        # tags them at non-upstream versions). Listing them on a node still makes
        # them the default version, which is what dlsym finds.
        mlx5dv_query_device;
        mlx5dv_create_qp;
    local:
        *;
} MLX5_1.2;

MLX5_1.21 {
    global:
        mlx5dv_dci_stream_id_reset;
    local:
        *;
} MLX5_1.8;

MLX5_1.25 {
    global:
        mlx5dv_get_data_direct_sysfs_path;
        mlx5dv_reg_dmabuf_mr;
    local:
        *;
} MLX5_1.21;
