GPU_PLATFORM: str = "@UNIFLOW_GPU_PLATFORM@"
GPU_ENABLED: bool = GPU_PLATFORM != "NONE"
CUDA_ENABLED: bool = GPU_PLATFORM == "CUDA"
RDMA_ENABLED: bool = "@UNIFLOW_ENABLE_RDMA@" == "ON"
NVLINK_ENABLED: bool = "@UNIFLOW_ENABLE_NVLINK@" == "ON"
TCP_ENABLED: bool = "@UNIFLOW_ENABLE_TCP@" == "ON"
