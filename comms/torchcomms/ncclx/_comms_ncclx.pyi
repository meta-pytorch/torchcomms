import torch
from torchcomms._comms import TorchCommWindow

class TorchCommWindowNCCLXGin(TorchCommWindow):
    def get_nvlink_address(self, peer: int, offset: int = 0) -> int: ...
    def get_multimem_address(self, offset: int = 0) -> int: ...

class TorchWork:
    def is_completed(self) -> bool: ...
    def wait(self) -> None: ...

class TorchCommNCCLX:
    def reduce_scatter_quantized(
        self,
        output: torch.Tensor,
        input: torch.Tensor,
        op: torch.distributed.ReduceOp,
        seed: torch.Tensor,
        async_op: bool,
    ) -> TorchWork: ...
    def comm_dump(self) -> dict[str, str]: ...
    def get_nccl_comm_ptr(self) -> int: ...
    def colltrace_get_comm_id(self) -> int | None: ...
    def colltrace_get_latest_coll_id(self) -> int | None: ...
    def colltrace_describe_coll(
        self, comm_id: int, captured_coll_id: int
    ) -> dict[str, object] | None: ...
    def set_config(self, hints: dict[str, str]) -> None: ...

def comm_dump_all(
    hints: dict[str, str] = ...,
) -> dict[str, dict[str, str]]: ...
def init_caching_allocator_hook() -> None: ...
